# Memory Configuration for Neural Analytics 3.0

# Memory backend: "memory" (in-memory only), "redis" (Redis only), or "hybrid" (in-memory + Redis fallback)
MEMORY_BACKEND=hybrid

# Redis connection URL (optional, only needed if using redis or hybrid backend)
# Format: redis://[username:password@]host:port/database
# Example: redis://localhost:6379/0
# Example with auth: redis://:password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Session expiration time in hours
# Sessions older than this will be automatically cleaned up
SESSION_TTL_HOURS=24

# Maximum number of conversation turns to store per session
# Older turns will be summarized to save memory
MAX_CONVERSATION_TURNS=50

# Number of turns before triggering automatic summarization
# Recent turns are kept in full, older ones are summarized
SUMMARIZE_AFTER_TURNS=5

# OpenAI API Key (required for LLM-based features)
OPENAI_API_KEY=your_openai_api_key_here

# Cohere API Key (required for SQL generation)
COHERE_API_KEY=your_cohere_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/neural_analytics

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# LangSmith Tracing (optional, for debugging)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=neural-analytics
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here