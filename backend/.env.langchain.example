# Neural Analytics 3.0 - LangChain Configuration

# ========== Database ==========
DATABASE_URL=postgresql://user:password@localhost:5432/olist_db

# ========== OpenAI (Primary LLM) ==========
OPENAI_API_KEY=sk-your-openai-api-key-here

# ========== Cohere (Optional - for embeddings) ==========
COHERE_API_KEY=postgresql://user:password@localhost:5432/olist_db

# ========== LangSmith Tracing (Highly Recommended) ==========
# Sign up at https://smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=neural-analytics-3.0
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# ========== Frontend ==========
FRONTEND_URL=http://localhost:5173

# ========== Model Configuration ==========
# Options: gpt-4-turbo-preview, gpt-4o, gpt-4.1-mini, claude-3-sonnet
PRIMARY_MODEL=gpt-4-turbo-preview
TEMPERATURE=0.0

# ========== Workflow Configuration ==========
MAX_SQL_RETRIES=2
QUERY_TIMEOUT_SECONDS=15
MAX_ROWS_LIMIT=200

# ========== Feature Flags ==========
ENABLE_ANOMALY_DETECTION=true
ENABLE_FORECASTING=true
ENABLE_CATEGORY_TRANSLATION=true