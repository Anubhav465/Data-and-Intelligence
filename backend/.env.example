# ============================================
# REQUIRED API KEYS
# ============================================

# OpenAI API Key (REQUIRED for LangChain/LangGraph)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Cohere AI API Key (REQUIRED for embeddings)
# Get from: https://cohere.com/
COHERE_API_KEY=your-cohere-api-key-here

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL Database Connection (REQUIRED)
DATABASE_URL=postgresql://user:password@localhost:5432/olist_db

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# LangSmith API Key (OPTIONAL - for debugging/observability)
# Get from: https://smith.langchain.com/
# Leave empty if you don't want LangSmith tracing
LANGSMITH_API_KEY=

# LangSmith Tracing (OPTIONAL)
# Set to 'true' to enable LangSmith tracing
LANGSMITH_TRACING=false

# LangSmith Project Name (OPTIONAL)
LANGSMITH_PROJECT=neural-analytics

# Redis URL (OPTIONAL - for distributed memory)
# Leave empty to use in-memory storage
# Example: redis://localhost:6379/0
REDIS_URL=

# Frontend URL (for CORS in production)
# Leave empty for local development (defaults to http://localhost:5173)
# Set to your Render frontend URL in production
FRONTEND_URL=http://localhost:5173

# Python Version (optional, for Render)
PYTHON_VERSION=3.11

# ============================================
# QUICK START GUIDE
# ============================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Add your OpenAI API key (REQUIRED)
# 3. Add your Cohere API key (REQUIRED)
# 4. Update DATABASE_URL if needed
# 5. Optionally add LangSmith key for debugging
# 6. Run: pip install -r requirements_langchain.txt
# 7. Run: python -m uvicorn app.api.routes:app --reload
